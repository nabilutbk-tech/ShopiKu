<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- Header Checkout -->
    <LinearLayout
        android:id="@+id/headerCheckout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#2C3E50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Checkout"
            android:textColor="#2C3E50"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBarCheckout"
        android:layout_below="@id/headerCheckout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Alamat Pengiriman -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat Pengiriman"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budi Santoso | 08123456789"
                        android:textColor="#2C3E50"
                        android:textStyle="bold" />

                    <!-- Alamat diatur ke Kota Cirebon sesuai spesifikasi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jl. Perjuangan No. 10B, Kesambi, Kota Cirebon, Jawa Barat 45131"
                        android:textColor="#7F8C8D"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Opsi Pengiriman -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opsi Pengiriman"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgShipping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbReguler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reguler (2-3 Hari) - Rp 15.000"
                    android:checked="true"
                    android:textColor="#2C3E50" />

                <RadioButton
                    android:id="@+id/rbExpress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Express (1 Hari) - Rp 25.000"
                    android:textColor="#2C3E50" />
            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Bar untuk Buat Pesanan -->
    <LinearLayout
        android:id="@+id/bottomBarCheckout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pembayaran:"
                android:textColor="#7F8C8D"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFinalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 165.000"
                android:textColor="#E74C3C"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMakeOrder"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:backgroundTint="#E67E22"
            android:text="Buat Pesanan"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>